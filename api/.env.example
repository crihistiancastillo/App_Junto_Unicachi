PORT=3000
# Sin DATABASE_URL la API usa PostgreSQL embebido (no requiere Docker).
# Descomenta para usar un PostgreSQL real:
# DATABASE_URL=postgres://junto:junto@localhost:5432/junto
# true solo en desarrollo: permite tokens "demo:<usuarioId>" sin Firebase
DEMO_MODE=true
ML_URL=http://localhost:8000
ML_INTERNAL_KEY=dev-internal-key
# fake | culqi
PAYMENT_GATEWAY=fake
CULQI_SECRET_KEY=
# Ruta al JSON de la cuenta de servicio de Firebase (Auth + Cloud Messaging)
FIREBASE_SERVICE_ACCOUNT=
JOB_INTERVAL_MS=60000
