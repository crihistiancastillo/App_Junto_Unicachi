# URL de la API (en Android Emulator, localhost del PC es 10.0.2.2)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# true: muestra las cuentas demo e inicia sesión sin Firebase
EXPO_PUBLIC_DEMO_MODE=true
# Firebase (proyecto web de Firebase Console > Configuración)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Culqi: llave PÚBLICA (pk_...). Sin ella se usa la pasarela simulada.
EXPO_PUBLIC_CULQI_PUBLIC_KEY=
